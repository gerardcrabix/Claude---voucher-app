# Copier ce fichier en .env.local (jamais commité, voir .gitignore) et
# renseigner les deux valeurs depuis Dashboard Supabase → Project Settings →
# API. La clé "anon" est publique par construction (voir src/supabase/
# client.js) — ce n'est pas un secret à protéger comme la clé "service_role"
# (celle-là ne doit JAMAIS être utilisée ici, seulement dans
# scripts/migrate-from-v1-backup.mjs, exécuté hors du navigateur).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
